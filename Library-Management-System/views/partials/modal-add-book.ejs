<!-- Add Book Modal Overlay -->
<div id="add-book-modal" class="hidden absolute inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4">
  <div class="bg-white dark:bg-[#1a2230] w-full max-w-3xl rounded-xl shadow-2xl border border-slate-200 dark:border-slate-800 flex flex-col max-h-[95vh] overflow-hidden">
    <!-- Modal Header -->
    <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Add New Book</h3>
      <button onclick="closeAddBookModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="p-6 overflow-y-auto">
      <form id="add-book-form" class="flex flex-col gap-6">
        <div class="flex flex-col md:flex-row gap-6">
          <!-- Book Cover Upload -->
          <div class="w-full md:w-1/3 flex-shrink-0">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Book Cover</label>
            <div class="relative w-full aspect-[2/3] border-2 border-dashed border-slate-300 dark:border-slate-600 rounded-lg hover:border-primary dark:hover:border-primary bg-slate-50 dark:bg-slate-800/50 transition-colors cursor-pointer group flex flex-col items-center justify-center text-center p-4">
              <div class="size-10 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-slate-400 dark:text-slate-300">cloud_upload</span>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Click to upload or drag and drop</p>
              <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-1">SVG, PNG, JPG (max. 800x1200px)</p>
              <input accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer" type="file"/>
            </div>
          </div>

          <!-- Book Details -->
          <div class="flex-1 space-y-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="book-title">Title</label>
              <input class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm" id="book-title" placeholder="e.g. The Great Gatsby" type="text"/>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="book-isbn">ISBN-13</label>
              <input class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm font-mono" id="book-isbn" placeholder="978-xxxxxxxxxx" type="text"/>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="book-author">Author</label>
              <input class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm" id="book-author" placeholder="Author Name" type="text"/>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="main-category">Main Category</label>
                <select class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm" id="main-category" onchange="updateSubCategories()">
                  <option disabled selected value="">Select Category</option>
                  <option value="fiction">Fiction</option>
                  <option value="science">Science &amp; Tech</option>
                  <option value="humanities">Humanities</option>
                  <option value="education">Education</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="sub-category">Sub-Category</label>
                <select class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm disabled:opacity-50 disabled:cursor-not-allowed" disabled id="sub-category">
                  <option disabled selected value="">Select Main Category First</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <!-- Additional Fields -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 pt-2 border-t border-slate-100 dark:border-slate-800/50">
          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="book-pages">Pages</label>
            <input class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm" id="book-pages" placeholder="e.g. 320" type="number"/>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="book-date">Publish Date</label>
            <input class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm" id="book-date" type="date"/>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="book-price">Price ($)</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">$</span>
              <input class="w-full pl-7 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm" id="book-price" placeholder="0.00" step="0.01" type="number"/>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="book-stock">Initial Stock</label>
            <input class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm" id="book-stock" placeholder="0" type="number"/>
          </div>
        </div>
      </form>
    </div>

    <!-- Modal Footer -->
    <div class="px-6 py-4 bg-slate-50 dark:bg-slate-800/50 border-t border-slate-200 dark:border-slate-700 flex justify-end gap-3">
      <button onclick="closeAddBookModal()" class="px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-200 transition-colors">
        Cancel
      </button>
      <button class="px-4 py-2 text-sm font-medium text-white bg-primary rounded-lg hover:bg-blue-600 active:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 transition-colors shadow-sm">
        Add Book
      </button>
    </div>
  </div>
</div>
