<div id="add-book-modal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-[#1a2230] w-full max-w-2xl rounded-2xl border border-slate-800 shadow-2xl overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-800 flex justify-between items-center bg-slate-900/50">
      <h3 class="text-lg font-bold text-white">Add New Book</h3>
    </div>

    <form id="addBookForm" class="p-6 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <div class="space-y-1">
          <label class="block text-xs font-bold text-slate-500 uppercase">Book Cover URL</label>
          <input type="url" name="image" id="add-book-image" placeholder="https://..." class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none focus:border-primary" required>
        </div>
        <div class="space-y-1">
          <label class="block text-xs font-bold text-slate-500 uppercase">Book Title</label>
          <input type="text" name="name" id="add-book-name" placeholder="The Great Gatsby" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none focus:border-primary" required>
        </div>

        <div class="space-y-1">
          <label class="block text-xs font-bold text-slate-500 uppercase">Author</label>
          <input type="text" name="author" id="add-book-author" placeholder="F. Scott Fitzgerald" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none focus:border-primary" required>
        </div>
        <div class="space-y-1">
          <label class="block text-xs font-bold text-slate-500 uppercase">Ref ID / ISBN</label>
          <input type="text" name="isbn" id="add-book-isbn" placeholder="e.g. 978-..." class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none focus:border-primary">
        </div>

        <div class="space-y-1">
          <label class="block text-xs font-bold text-slate-500 uppercase">Main Category</label>
          <select id="mainCategorySelect" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none focus:border-primary">
            <option value="">Select Main Category</option>
          </select>
        </div>
        <div class="space-y-1">
          <label class="block text-xs font-bold text-slate-500 uppercase">Sub-Category</label>
          <select name="categoryId" id="subCategorySelect" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none focus:border-primary" required disabled>
            <option value="">Select Main First</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4 col-span-2">
          <div class="space-y-1">
            <label class="block text-xs font-bold text-slate-500 uppercase">Price (EGP)</label>
            <input type="number" name="price" id="add-book-price" placeholder="250" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none focus:border-primary" required>
          </div>
          <div class="space-y-1">
            <label class="block text-xs font-bold text-slate-500 uppercase">Initial Stock</label>
            <input type="number" name="quantity" id="add-book-stock" placeholder="10" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none focus:border-primary" required>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-3 pt-4 border-t border-slate-800">
        <button type="button" onclick="closeAddBookModal()" class="px-6 py-2.5 rounded-xl text-slate-400 hover:text-white font-medium transition-colors">Cancel</button>
        <button type="submit" class="bg-primary hover:bg-blue-600 text-white px-8 py-2.5 rounded-xl font-bold transition-all active:scale-95 shadow-lg shadow-blue-500/20">Add Book</button>
      </div>
    </form>
  </div>
</div>