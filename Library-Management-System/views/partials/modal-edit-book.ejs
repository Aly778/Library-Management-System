<!-- Edit Book Modal Overlay -->
<div id="edit-book-modal" class="hidden absolute inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4">
  <div class="bg-white dark:bg-[#1a2230] w-full max-w-3xl rounded-xl shadow-2xl border border-slate-200 dark:border-slate-800 flex flex-col max-h-[95vh] overflow-hidden">
    <!-- Modal Header -->
    <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Edit Book Details</h3>
      <button onclick="closeEditBookModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors">
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="p-6 overflow-y-auto">
      <form id="edit-book-form" class="flex flex-col gap-6">
        <div class="flex flex-col md:flex-row gap-6">
          <!-- Book Cover with Preview -->
          <div class="w-full md:w-1/3 flex-shrink-0">
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Book Cover</label>
            <div class="relative w-full aspect-[2/3] border border-slate-300 dark:border-slate-600 rounded-lg overflow-hidden group cursor-pointer bg-slate-50 dark:bg-slate-800">
              <img id="edit-book-cover-preview" alt="Current Book Cover" class="w-full h-full object-cover transition-transform group-hover:scale-105 duration-300" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDqCIkw36GlOcKd7UhzhliYevrr8KQeeGzI-3Mt-fOL9lIu4pQP3TaW2pTIQHtUZqA-yucJY7pl3PbcCqZBkUX-mU1mw9Tuo7AbQ14H7e19E5wsJ5pBFMqC95vYx6W_b0RRXYLNdQfJxAsfSrfO8Alq8RL1BKJmBkp1thFyJMgkoT27aW4Lj4-y0q0-y9wAQ7-U7N3dkqDajm95Q1RMqkKJNl50bAndD5pWmszPfXYoHhqEyV9JyfLJX14UMjs-mZH3UtZymLcNnFk"/>
              <div class="absolute inset-0 bg-black/50 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                <span class="material-symbols-outlined text-white mb-2">edit</span>
                <span class="text-xs font-medium text-white bg-black/50 px-3 py-1.5 rounded-full backdrop-blur-sm">Change Cover</span>
              </div>
              <input accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer" type="file"/>
            </div>
          </div>

          <!-- Book Details -->
          <div class="flex-1 space-y-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="edit-book-title">Title</label>
              <input class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm" id="edit-book-title" placeholder="e.g. The Great Gatsby" type="text" value="The Great Gatsby"/>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="edit-book-isbn">ISBN-13</label>
              <input class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm font-mono" id="edit-book-isbn" placeholder="978-xxxxxxxxxx" type="text" value="978-0743273565"/>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="edit-book-author">Author</label>
              <input class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm" id="edit-book-author" placeholder="Author Name" type="text" value="F. Scott Fitzgerald"/>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="edit-main-category">Main Category</label>
                <select class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm" id="edit-main-category" onchange="updateEditSubCategories()">
                  <option disabled value="">Select Category</option>
                  <option selected value="fiction">Fiction</option>
                  <option value="science">Science &amp; Tech</option>
                  <option value="humanities">Humanities</option>
                  <option value="education">Education</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="edit-sub-category">Sub-Category</label>
                <select class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm" id="edit-sub-category">
                  <option value="psych-thrillers">Psychological Thrillers</option>
                  <option selected value="historical">Historical Fiction</option>
                  <option value="dystopian">Dystopian &amp; Sci-Fi</option>
                  <option value="mystery">Mystery &amp; Crime</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <!-- Additional Fields -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 pt-2 border-t border-slate-100 dark:border-slate-800/50">
          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="edit-book-pages">Pages</label>
            <input class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm" id="edit-book-pages" placeholder="e.g. 320" type="number" value="180"/>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="edit-book-date">Publish Date</label>
            <input class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm" id="edit-book-date" type="date" value="1925-04-10"/>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="edit-book-price">Price ($)</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">$</span>
              <input class="w-full pl-7 rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm" id="edit-book-price" placeholder="0.00" step="0.01" type="number" value="15.00"/>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" for="edit-book-stock">Stock</label>
            <input class="w-full rounded-lg border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm focus:border-primary focus:ring-primary/20 sm:text-sm" id="edit-book-stock" placeholder="0" type="number" value="42"/>
          </div>
        </div>
      </form>
    </div>

    <!-- Modal Footer -->
    <div class="px-6 py-4 bg-slate-50 dark:bg-slate-800/50 border-t border-slate-200 dark:border-slate-700 flex justify-end gap-3">
      <button onclick="closeEditBookModal()" class="px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-200 transition-colors">
        Cancel
      </button>
      <button class="px-4 py-2 text-sm font-medium text-white bg-primary rounded-lg hover:bg-blue-600 active:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 transition-colors shadow-sm">
        Save Changes
      </button>
    </div>
  </div>
</div>
