<script>
/**
 * Global Logout Function 
 * Ensures session data is wiped and the user is redirected to the login page.
 */
window.handleLogout = function() {
  // Clear all session storage
  localStorage.removeItem('authToken');
  localStorage.removeItem('user');
  
  // Also clear cart to prevent mix-ups between users
  localStorage.removeItem('cart');
  
  // Force browser to sign-in page
  window.location.href = '/login';
};

/**
 * Sidebar Initialization 
 * Pulls the logged-in user's name from localStorage and displays it.
 */
document.addEventListener('DOMContentLoaded', () => {
  const userInfo = localStorage.getItem('user');
  if (userInfo) {
    try {
      const user = JSON.parse(userInfo);
      if (user.firstName) {
        document.getElementById('sidebarFirstName').textContent = user.firstName;
      }
      if (user.lastName) {
        document.getElementById('sidebarLastName').textContent = user.lastName;
      }
    } catch (e) {
      console.error('Sidebar: Error parsing user session info');
    }
  }
});
</script>