<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <%- include('partials/head', { title: 'LibAdmin Dashboard' }) %>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: '#3b82f6',
            background: { light: '#f8fafc', dark: '#0f172a' }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-[#0f172a] font-display text-slate-900 dark:text-slate-100 antialiased h-screen flex overflow-hidden">

  <%- include('partials/sidebar-dashboard') %>

  <div class="flex-1 flex flex-col h-full relative overflow-hidden">
    
    <header class="h-16 bg-white dark:bg-[#1a2230] border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-8 shrink-0 z-10">
      <h1 class="text-2xl font-bold">System Dashboard</h1>
    </header>

    <main class="flex-1 overflow-y-auto p-8 scroll-smooth">
      <div class="max-w-7xl mx-auto flex flex-col gap-8 min-h-full pb-12">
        
        <div class="flex flex-col gap-1">
          <h3 id="greetingMessage" class="text-2xl font-bold text-white">Welcome Back!</h3>
          <p class="text-slate-400">Actual system performance and personnel management metrics.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white dark:bg-[#1a2230] p-6 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800">
            <h4 class="text-slate-400 text-sm font-medium mb-1">Actual Total Books</h4>
            <p id="statTotalBooks" class="text-3xl font-bold text-white">0</p>
          </div>
          <div class="bg-white dark:bg-[#1a2230] p-6 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800">
            <h4 class="text-slate-400 text-sm font-medium mb-1">Purchasing Customers</h4>
            <p id="statTotalCustomers" class="text-3xl font-bold text-white">0</p>
          </div>
          <div class="bg-white dark:bg-[#1a2230] p-6 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800">
            <h4 class="text-slate-400 text-sm font-medium mb-1">Actual Total Sales</h4>
            <p id="statTotalSold" class="text-3xl font-bold text-primary">0</p>
          </div>
        </div>

        <div class="bg-white dark:bg-[#1a2230] p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
          <h3 class="text-lg font-bold mb-6 text-white">Personnel Management</h3>
          <div class="flex flex-wrap gap-4">
            <button onclick="openModal('add-employee-modal')" class="bg-primary hover:bg-blue-600 text-white px-6 py-3 rounded-xl text-sm font-bold flex items-center gap-2 transition-all active:scale-95 shadow-lg shadow-blue-500/20">
              <span class="material-symbols-outlined">person_add</span> Add Employee
            </button>
            <button onclick="openModal('remove-employee-modal')" class="bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-xl text-sm font-bold flex items-center gap-2 transition-all active:scale-95">
              <span class="material-symbols-outlined">person_remove</span> Remove Employee
            </button>
            <button onclick="loadEmployees()" class="border border-slate-700 hover:bg-slate-800 text-white px-6 py-3 rounded-xl text-sm font-bold flex items-center gap-2 transition-all">
              <span class="material-symbols-outlined">group</span> View All Employees
            </button>
          </div>
        </div>

        <div id="personnelContainer" class="hidden bg-white dark:bg-[#1a2230] rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-xl">
           <table class="w-full text-left text-sm text-slate-400">
              <thead class="bg-slate-50 dark:bg-slate-900/50 text-white font-bold uppercase text-xs border-b border-slate-800">
                <tr>
                  <th class="px-6 py-4">Employee Name</th>
                  <th class="px-6 py-4">Current Role</th>
                </tr>
              </thead>
              <tbody id="employeeTableBody" class="divide-y divide-slate-800"></tbody>
           </table>
        </div>
      </div>
    </main>
  </div>

  <div id="add-employee-modal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-[#1a2230] w-full max-w-lg rounded-2xl border border-slate-800 shadow-2xl overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-800 flex justify-between items-center bg-slate-900/50">
        <h3 class="text-lg font-bold text-white">Add New Employee</h3>
        <button onclick="closeModal('add-employee-modal')" class="text-slate-400 hover:text-white transition-colors">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <form id="addEmployeeForm" class="p-6 grid grid-cols-2 gap-4">
        <div class="col-span-2">
          <label class="block text-xs font-bold text-slate-500 mb-2 uppercase">Role</label>
          <select name="role" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none" required>
            <option value="admin">Admin</option>
            <option value="superAdmin">Super Admin</option>
          </select>
        </div>
        <input type="text" name="firstName" placeholder="First Name" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none" required>
        <input type="text" name="lastName" placeholder="Last Name" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none" required>
        <input type="email" name="email" placeholder="Email Address" class="col-span-2 w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none" required>
        <input type="password" name="password" placeholder="Password" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none" required>
        <input type="text" name="phone" placeholder="Phone Number" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none" required>
        <div class="col-span-2 grid grid-cols-2 gap-4">
          <div class="flex flex-col gap-1">
            <label class="text-[10px] font-bold text-slate-500 uppercase">DOB</label>
            <input type="date" name="dob" class="bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none" required>
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-[10px] font-bold text-slate-500 uppercase">Gender</label>
            <select name="gender" class="bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none">
              <option value="Male">Male</option>
              <option value="Female">Female</option>
            </select>
          </div>
        </div>
        <button type="submit" class="col-span-2 bg-primary text-white py-3 rounded-xl font-bold mt-2 shadow-lg shadow-blue-500/20">Create Account</button>
      </form>
    </div>
  </div>

  <div id="remove-employee-modal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-[#1a2230] w-full max-w-md rounded-2xl border border-slate-800 shadow-2xl">
      <div class="px-6 py-4 border-b border-slate-800 flex justify-between items-center bg-red-900/10">
        <h3 class="text-lg font-bold text-white">Verify Removal</h3>
        <button onclick="closeModal('remove-employee-modal')" class="text-slate-400 hover:text-white transition-colors">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <form id="removeEmployeeForm" class="p-6 space-y-4">
        <p class="text-sm text-slate-400">Enter employee credentials to confirm removal.</p>
        <input type="email" name="email" placeholder="Staff Email" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none" required>
        <input type="password" name="password" placeholder="Staff Password" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-white text-sm outline-none" required>
        <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white py-3 rounded-xl font-bold transition-all">Terminate Access</button>
      </form>
    </div>
  </div>

  <script src="/js/api-service.js"></script>
  <script>
    // DASHBOARD INITIALIZATION logic
    document.addEventListener('DOMContentLoaded', () => {
      fetchLiveStats();
      const user = JSON.parse(localStorage.getItem('user'));
      if (user?.firstName) {
        document.getElementById('greetingMessage').textContent = `Good Morning, ${user.firstName}!`;
      }
    });

    /**
     * DYNAMIC STATS logic
     * Fetches real counts from backend instead of placeholders.
     */
    async function fetchLiveStats() {
      try {
        const booksData = await apiService.getBooks(); // All books
        const historyData = await apiService.getAllPurchases(); // All sales
        
        if (booksData.success && historyData.success) {
          // Unique Books: Count distinct names to ignore duplicate inventory entries
          const uniqueBooks = [...new Set(booksData.books.map(b => b.Bname))].length;
          document.getElementById('statTotalBooks').textContent = uniqueBooks;

          // Purchasing Customers: Count distinct User IDs in transaction history
          const uniqueCustomers = [...new Set(historyData.purchases.map(p => p.Uid))].length;
          document.getElementById('statTotalCustomers').textContent = uniqueCustomers;

          // Actual Sales: Sum total quantity of books purchased
          const totalSold = historyData.purchases.reduce((acc, p) => acc + p.Pquantity, 0);
          document.getElementById('statTotalSold').textContent = totalSold;
        }
      } catch (err) {
        console.error('Stats Error:', err);
        if (err.message.includes('Forbidden')) {
          alert("Access Denied: Log out and back in to refresh session token.");
        }
      }
    }

    /**
     * STAFF DIRECTORY logic
     */
    async function loadEmployees() {
      const tbody = document.getElementById('employeeTableBody');
      const container = document.getElementById('personnelContainer');
      try {
        const res = await apiService.getEmployeeDirectory();
        tbody.innerHTML = res.employees.map(e => `
          <tr class="hover:bg-slate-800/50 transition-colors">
            <td class="px-6 py-4 text-white font-medium">${e.Ufirst_name} ${e.Ulast_name}</td>
            <td class="px-6 py-4"><span class="px-2 py-1 rounded-md text-[10px] uppercase font-bold bg-blue-900/40 text-blue-300 border border-blue-500/20">${e.Urole}</span></td>
          </tr>`).join('');
        container.classList.remove('hidden');
      } catch (err) { 
        alert("Access Denied: Only Super Admins can view this list."); 
      }
    }

    /**
     * FORM HANDLING logic
     * Fixed ReferenceError by using correct HTML IDs.
     */
    document.getElementById('addEmployeeForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData.entries());
      try {
        const res = await apiService.addEmployee(data);
        alert(res.message);
        closeModal('add-employee-modal');
        fetchLiveStats();
      } catch (err) { alert(err.message); }
    });

    document.getElementById('removeEmployeeForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData.entries());
      try {
        const res = await apiService.removeEmployee(data);
        alert(res.message);
        closeModal('remove-employee-modal');
        fetchLiveStats();
      } catch (err) { alert(err.message); }
    });

    function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
    function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
  </script>
</body>
</html>