<!DOCTYPE html>
<html class="light dark" lang="en">
<head>
  <%- include('partials/head', { title: 'Book Catalog' }) %>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: '#3b82f6',
            background: {
              light: '#f8fafc',
              dark: '#0f172a'
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 font-display antialiased h-screen flex overflow-hidden">

  <%- include('partials/sidebar') %>

  <div class="flex-1 flex flex-col h-full overflow-hidden relative">
    <header class="h-16 bg-white dark:bg-[#1a2230] border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-8 flex-shrink-0 z-10">
      <h1 class="text-2xl font-bold">Book Catalog</h1>
      <div class="flex items-center gap-4">
        <a href="/cart" class="relative group">
          <span class="material-symbols-outlined text-2xl hover:text-primary transition-colors">shopping_cart</span>
          <span id="cartCount" class="absolute -top-2 -right-2 bg-red-500 text-white text-[10px] font-bold rounded-full w-5 h-5 flex items-center justify-center border-2 border-white dark:border-[#1a2230]">0</span>
        </a>
      </div>
    </header>

    <main class="flex-1 overflow-y-auto p-8">
      <div class="max-w-7xl mx-auto flex flex-col gap-8">
        <div class="bg-white dark:bg-[#1a2230] p-6 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800">
          <div class="flex flex-col lg:flex-row gap-4 items-center">
            <div class="flex-1 w-full relative group">
              <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <span class="material-symbols-outlined text-slate-400">search</span>
              </span>
              <input id="searchInput" 
                class="block w-full pl-12 pr-4 py-3 rounded-xl bg-slate-100 dark:bg-slate-900 border-none focus:ring-2 focus:ring-primary/50 text-sm transition-all" 
                placeholder="Search by title or author..." type="text"/>
            </div>
            
            <select id="categoryFilter" class="w-full lg:w-64 px-4 py-3 rounded-xl bg-slate-100 dark:bg-slate-900 border-none focus:ring-2 focus:ring-primary/50 text-sm cursor-pointer">
              <option value="">All Categories</option>
            </select>

            <button onclick="loadCatalog()" class="w-full lg:w-auto px-6 py-3 bg-primary hover:bg-blue-600 text-white rounded-xl font-bold shadow-lg shadow-blue-500/20 transition-all flex items-center justify-center gap-2 active:scale-95">
              <span class="material-symbols-outlined text-xl">refresh</span> Refresh
            </button>
          </div>
        </div>

        <div id="booksContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 pb-12">
          <div class="col-span-full text-center py-24">
            <span class="material-symbols-outlined text-6xl text-slate-300 animate-pulse block mb-4">hourglass_empty</span>
            <p class="text-slate-500 dark:text-slate-400 font-medium">Fetching your library...</p>
          </div>
        </div>
      </div>
    </main>
  </div>

  <%- include('partials/footer') %>

  <script src="/js/api-service.js"></script>
  <script src="/js/auth-service.js"></script>
  <script src="/js/cart-service.js"></script>
  <script src="/js/catalog-manager.js"></script>
  <script src="/js/main.js"></script>

  <script>
    async function loadCatalog() {
      try {
        const booksResponse = await apiService.getBooks();
        if (booksResponse.success) {
          catalogManager.books = booksResponse.books;
          catalogManager.filteredBooks = booksResponse.books;
          renderBooks();
        }
        
        const categoriesResponse = await apiService.getCategories();
        if (categoriesResponse.success) {
          catalogManager.categories = categoriesResponse.categories;
          populateCategories();
        }
      } catch (error) {
        console.error('Catalog Load Error:', error);
        if (typeof showError === 'function') showError('Connection lost: ' + error.message);
      }
    }

    function renderBooks() {
      const container = document.getElementById('booksContainer');
      if (!catalogManager.filteredBooks || catalogManager.filteredBooks.length === 0) {
        container.innerHTML = `
          <div class="col-span-full text-center py-24 bg-white dark:bg-[#1a2230] rounded-2xl border-2 border-dashed border-slate-200 dark:border-slate-800">
            <span class="material-symbols-outlined text-6xl text-slate-300 mb-4">search_off</span>
            <p class="text-slate-500">No books found in the database.</p>
          </div>`;
        return;
      }
      // Renders using the high-fidelity card design from catalog-manager.js
      container.innerHTML = catalogManager.filteredBooks.map(book => catalogManager.renderBookCard(book)).join('');
    }

    function populateCategories() {
      const select = document.getElementById('categoryFilter');
      const currentValue = select.value;
      select.innerHTML = '<option value="">All Categories</option>';
      catalogManager.categories.forEach(cat => {
        const option = document.createElement('option');
        option.value = cat.Cid;
        option.textContent = cat.Cname;
        select.appendChild(option);
      });
      select.value = currentValue;
    }

    // Interaction Handlers
    document.getElementById('searchInput').addEventListener('input', (e) => {
      catalogManager.searchBooks(e.target.value);
      renderBooks();
    });

    document.getElementById('categoryFilter').addEventListener('change', (e) => {
      catalogManager.filterByCategory(e.target.value);
      renderBooks();
    });

    function updateCartCount() {
      const countEl = document.getElementById('cartCount');
      if (countEl && typeof cartService !== 'undefined') {
        countEl.textContent = cartService.getItemCount();
      }
    }

    // Lifecycle
    document.addEventListener('DOMContentLoaded', () => {
      if (!authService.isAuthenticated()) {
        window.location.href = '/login';
        return;
      }
      loadCatalog();
      updateCartCount();
      
      // Hook into cart updates to refresh count bubble
      const originalAdd = cartService.addItem.bind(cartService);
      cartService.addItem = (...args) => {
        originalAdd(...args);
        updateCartCount();
      };
    });
  </script>
</body>
</html>