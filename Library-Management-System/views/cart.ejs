<!DOCTYPE html>
<html class="light dark" lang="en">
<head>
  <%- include('partials/head', { title: 'Shopping Cart' }) %>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: '#3b82f6',
            background: { light: '#f8fafc', dark: '#0f172a' }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-background-light dark:bg-background-dark text-[#111318] dark:text-white min-h-screen flex flex-col font-display antialiased">

  <div class="relative flex w-full flex-col bg-white dark:bg-[#1a2130] border-b border-[#f0f2f4] dark:border-gray-800">
    <header class="flex items-center justify-between px-10 py-3 mx-auto w-full max-w-[1440px]">
      <div class="flex items-center gap-8">
        <div class="flex items-center gap-4">
          <div class="size-8 flex items-center justify-center rounded bg-primary/10 text-primary">
            <span class="material-symbols-outlined text-2xl">local_library</span>
          </div>
          <h2 class="text-lg font-bold">Library System</h2>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <a href="/catalog" class="text-sm font-medium hover:text-primary transition-colors">Back to Marketplace</a>
      </div>
    </header>
  </div>

  <main class="flex-grow w-full max-w-[1440px] mx-auto px-6 py-8">
    <div class="flex flex-wrap gap-2 mb-8 items-center">
      <a class="text-[#616f89] dark:text-gray-400 text-sm font-medium hover:text-primary hover:underline" href="/catalog">Catalog</a>
      <span class="text-[#616f89] dark:text-gray-600 text-sm font-medium">/</span>
      <span class="text-[#111318] dark:text-white text-sm font-semibold">Cart</span>
    </div>

    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
      <div>
        <h1 class="text-[#111318] dark:text-white text-4xl font-black">Shopping Cart</h1>
        <p class="text-[#616f89] dark:text-gray-400 text-base font-normal mt-1">Review your selected items before checking out.</p>
      </div>
    </div>

    <div class="flex flex-col lg:flex-row gap-8">
      <div id="cartItemsContainer" class="flex-1 flex flex-col gap-4">
        </div>

      <div class="lg:w-[380px] shrink-0">
        <div class="bg-white dark:bg-[#1a2130] rounded-xl border border-[#f0f2f4] dark:border-gray-800 shadow-sm p-6 lg:sticky lg:top-8">
          <h3 class="text-[#111318] dark:text-white text-xl font-bold mb-6">Order Summary</h3>
          <div class="space-y-4 mb-6 border-b border-[#f0f2f4] dark:border-gray-800 pb-6">
            <div class="flex justify-between text-[#616f89] dark:text-gray-400">
              <span id="itemCountLabel">Subtotal (0 items)</span>
              <span id="subtotalAmount" class="font-medium text-[#111318] dark:text-white">0.00 EGP</span>
            </div>
          </div>
          <div class="flex justify-between items-center mb-6">
            <span class="text-lg font-bold text-[#111318] dark:text-white">Total</span>
            <span id="totalAmount" class="text-2xl font-black text-[#111318] dark:text-white">0.00 EGP</span>
          </div>
          <button onclick="handleCheckout()" class="w-full flex items-center justify-center rounded-lg h-12 px-4 bg-primary text-white text-base font-bold hover:bg-blue-700 transition-all shadow-lg shadow-blue-500/20">
            Proceed to Checkout
          </button>
        </div>
      </div>
    </div>
  </main>

  <footer class="mt-auto border-t border-[#f0f2f4] dark:border-gray-800 bg-white dark:bg-[#1a2130] py-8">
    <div class="max-w-[1440px] mx-auto px-10 text-center text-[#616f89] dark:text-gray-500 text-sm">
      © <%= new Date().getFullYear() %> City Library System. All rights reserved.
    </div>
  </footer>

  <script src="/js/api-service.js"></script>
  <script src="/js/cart-service.js"></script>
  <script>
    function renderCart() {
      const container = document.getElementById('cartItemsContainer');
      const items = cartService.getItems(); // [cite: 87]

      if (items.length === 0) {
        container.innerHTML = `
          <div class="flex flex-col items-center justify-center py-20 bg-white dark:bg-[#1a2130] rounded-xl border border-dashed border-gray-300 dark:border-gray-700">
            <span class="material-symbols-outlined text-6xl text-gray-300 mb-4">shopping_cart_off</span>
            <p class="text-gray-500 dark:text-gray-400 text-lg font-medium">Your cart is empty</p>
            <a href="/catalog" class="mt-4 text-primary font-bold hover:underline">Explore Marketplace</a>
          </div>
        `;
        updateSummary(0, 0);
        return;
      }

      container.innerHTML = items.map(item => `
        <div class="flex flex-col sm:flex-row gap-4 bg-white dark:bg-[#1a2130] p-4 rounded-xl border border-[#f0f2f4] dark:border-gray-800 shadow-sm">
          <div class="shrink-0">
            <img src="${item.Bimage}" class="rounded-lg w-full sm:w-[100px] aspect-[3/4] object-cover" onerror="this.src='https://via.placeholder.com/150x200?text=No+Cover'">
          </div>
          <div class="flex flex-1 flex-col justify-between">
            <div class="flex justify-between items-start">
              <div>
                <h3 class="text-[#111318] dark:text-white text-lg font-bold">${item.Bname}</h3>
                <p class="text-primary font-bold text-lg mt-1">${item.Bprice} EGP</p>
              </div>
            </div>
            <div class="flex justify-between items-end mt-4">
              <div class="flex items-center gap-3">
                <span class="text-sm font-medium text-gray-500">Qty:</span>
                <div class="flex items-center border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
                  <button onclick="updateQty(${item.Bid}, ${item.quantity - 1})" class="w-8 h-8 flex items-center justify-center bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-600 dark:text-gray-300 transition-colors">-</button>
                  <span class="w-10 text-center text-sm font-bold text-[#111318] dark:text-white">${item.quantity}</span>
                  <button onclick="updateQty(${item.Bid}, ${item.quantity + 1})" class="w-8 h-8 flex items-center justify-center bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-600 dark:text-gray-300 transition-colors">+</button>
                </div>
              </div>
              <button onclick="removeItem(${item.Bid})" class="text-red-600 hover:text-red-700 text-sm font-medium flex items-center gap-1 transition-colors">
                <span class="material-symbols-outlined text-[18px]">delete</span> Remove
              </button>
            </div>
          </div>
        </div>
      `).join('');

      updateSummary(cartService.getTotal(), cartService.getItemCount()); // [cite: 87]
    }

    function updateSummary(total, count) {
      document.getElementById('itemCountLabel').textContent = `Subtotal (${count} items)`;
      document.getElementById('subtotalAmount').textContent = `${total.toFixed(2)} EGP`;
      document.getElementById('totalAmount').textContent = `${total.toFixed(2)} EGP`;
    }

    function updateQty(id, newQty) {
      if (newQty < 1) return;
      cartService.updateQuantity(id, newQty); // [cite: 87]
      renderCart();
    }

    function removeItem(id) {
      cartService.removeItem(id); // [cite: 87]
      renderCart();
    }

    async function handleCheckout() {
      const items = cartService.getItems(); // [cite: 87]
      if (items.length === 0) return;

      try {
        const response = await apiService.purchaseBooks(items); //
        if (response.success) {
          cartService.clear(); // [cite: 87]
          alert('Purchase completed successfully! Your books are ready.');
          window.location.href = '/history';
        }
      } catch (error) {
        alert('Checkout failed: ' + error.message);
      }
    }

    document.addEventListener('DOMContentLoaded', renderCart);
  </script>
</body>
</html>