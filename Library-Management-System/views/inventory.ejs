<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <%- include('partials/head', { title: 'Inventory Management' }) %>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: '#3b82f6',
            background: { light: '#f8fafc', dark: '#0f172a' }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-[#0f172a] font-display text-slate-100 antialiased h-screen flex overflow-hidden">

  <div id="sidebarContainer" class="h-full"></div>

  <template id="superAdminSidebar">
    <aside class="w-64 h-full border-r border-slate-800 bg-[#1a2230] flex flex-col justify-between">
      <div class="flex flex-col gap-6 p-4">
        <div class="flex items-center gap-3 px-2">
          <div class="flex items-center justify-center rounded-lg bg-[#1e3a8a] text-white size-10 shadow-md">
            <span class="material-symbols-outlined">local_library</span>
          </div>
          <div class="flex flex-col">
            <h1 class="text-white text-lg font-bold leading-tight">LibAdmin</h1>
            <p class="text-slate-400 text-xs">Management System</p>
          </div>
        </div>
        <nav class="flex flex-col gap-1">
          <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:bg-slate-800 transition-colors group" href="/dashboard">
            <span class="material-symbols-outlined text-[24px]">dashboard</span>
            <span class="text-sm font-medium group-hover:text-white">Dashboard</span>
          </a>
          <a class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-[#1e3a8a]/20 text-blue-300 group" href="/inventory">
            <span class="material-symbols-outlined text-[24px]">menu_book</span>
            <span class="text-sm font-medium">Inventory</span>
          </a>
        </nav>
      </div>
      <div class="p-4 border-t border-slate-800">
        <div class="flex items-center gap-3 px-3 py-2 justify-between">
          <div class="flex items-center gap-3 overflow-hidden flex-1">
            <div class="bg-center bg-no-repeat bg-cover rounded-full size-9 border border-slate-800" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuCSEABfDP0NX7x2Xu6ZBjx8wgxEGapZ8Vj9RSvx_MPA50__Kr8Qbq6o4SwqqayF2v1x-1Z9BANEyv28rRzFndjDtOKXmTBZ-UECFg7F4r2kLXnLT8AJqC2SZ30U2nAv5NSWLzDb_WSWo53WJ7hCuqaq299kqBzFIBBuEp7A6xs8-FuT757qIWKw0Z85ym1ylifPmnbiALXggpUww6EgdJMWke2DcSaA95Z90nBamgUdIkTXIjOJmkK-iSx2R041fclBF0TMsh5Xg2Y");'></div>
            <div class="flex flex-col overflow-hidden flex-1">
              <p id="sidebarFirstName" class="text-white text-sm font-medium truncate">User</p>
              <p id="sidebarLastName" class="text-slate-500 text-xs truncate">Name</p>
            </div>
          </div>
          <button onclick="handleLogout()" class="text-slate-500 hover:text-blue-400 transition-colors">
            <span class="material-symbols-outlined">logout</span>
          </button>
        </div>
      </div>
    </aside>
  </template>

  <template id="adminSidebar">
     <%- include('partials/sidebar-admin') %>
  </template>

  <div class="flex-1 flex flex-col h-full overflow-hidden relative">
    <header class="h-16 bg-[#1a2230] border-b border-slate-800 flex items-center justify-between px-8 shrink-0">
      <h1 class="text-xl font-bold text-white">Inventory Management</h1>
      <button onclick="openAddBookModal()" class="bg-primary hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-medium flex items-center gap-2">
        <span class="material-symbols-outlined text-[18px]">add</span> Add New Book
      </button>
    </header>

    <main class="flex-1 overflow-y-auto p-8">
      <div class="max-w-7xl mx-auto flex flex-col gap-6">
        <div class="bg-[#1a2230] p-4 rounded-xl border border-slate-800">
          <div class="max-w-lg relative group">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400 material-symbols-outlined">search</span>
            <input id="inventorySearch" class="block w-full pl-10 pr-3 py-2.5 rounded-lg bg-slate-900 text-white text-sm border-none focus:ring-2 focus:ring-primary/50" placeholder="Search by title or author...">
          </div>
        </div>

        <div class="bg-[#1a2230] rounded-xl border border-slate-800 overflow-hidden">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-slate-900/50 border-b border-slate-800 text-xs font-semibold uppercase text-slate-400">
                <th class="py-4 px-6 w-12"><input type="checkbox" class="rounded border-slate-700 bg-slate-800"></th>
                <th class="py-4 px-6">Book Details</th>
                <th class="py-4 px-6">ISBN (ID)</th>
                <th class="py-4 px-6">Category</th>
                <th class="py-4 px-6 text-right">Price</th>
                <th class="py-4 px-6 text-center">Stock</th>
                <th class="py-4 px-6 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="inventoryTableBody" class="divide-y divide-slate-800">
              <tr><td colspan="7" class="py-20 text-center text-slate-500">Connecting to database...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <%- include('partials/modal-add-book') %>
  <%- include('partials/modal-edit-book') %>

  <script src="/js/api-service.js"></script>
  <script src="/js/auth-service.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const user = authService.getUser();
      const container = document.getElementById('sidebarContainer');
      
      if (user && user.role.toLowerCase() === 'superadmin') {
        container.appendChild(document.getElementById('superAdminSidebar').content.cloneNode(true));
      } else if (user && user.role.toLowerCase() === 'admin') {
        container.appendChild(document.getElementById('adminSidebar').content.cloneNode(true));
      } else {
        window.location.href = '/login';
        return;
      }

      const userInfo = localStorage.getItem('user');
      if (userInfo) {
        const parsed = JSON.parse(userInfo);
        if (document.getElementById('sidebarFirstName')) document.getElementById('sidebarFirstName').textContent = parsed.firstName;
        if (document.getElementById('sidebarLastName')) document.getElementById('sidebarLastName').textContent = parsed.lastName;
      }
      
      loadInventory();
      setupCategoryDropdowns();
    });

    async function loadInventory() {
      const tbody = document.getElementById('inventoryTableBody');
      try {
        const response = await apiService.getBooks();
        if (response.success && response.books) {
          tbody.innerHTML = response.books.map(book => `
            <tr class="hover:bg-slate-800/50 transition-colors">
              <td class="py-4 px-6"><input type="checkbox" class="rounded border-slate-700 bg-slate-800"></td>
              <td class="py-4 px-6">
                <p class="text-sm font-semibold text-white">${book.Bname}</p>
                <p class="text-xs text-slate-400">${book.BAuthor || 'Unknown'}</p>
              </td>
              <td class="py-4 px-6 text-sm font-mono text-slate-300">#${book.Bid}</td>
              <td class="py-4 px-6">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-900/30 text-blue-300 border border-blue-500/20">${book.category_name || 'Uncategorized'}</span>
              </td>
              <td class="py-4 px-6 text-sm text-right font-medium text-white">${book.Bprice} EGP</td>
              <td class="py-4 px-6 text-center">
                <span class="text-sm font-bold ${book.Bquantity < 5 ? 'text-red-500' : 'text-white'}">${book.Bquantity}</span>
              </td>
              <td class="py-4 px-6 text-right">
                <button onclick="openEditBookModal(${book.Bid})" class="text-slate-400 hover:text-primary transition-colors"><span class="material-symbols-outlined text-[20px]">edit</span></button>
                <button onclick="handleDeleteBook(${book.Bid})" class="text-slate-400 hover:text-red-500 ml-2 transition-colors"><span class="material-symbols-outlined text-[20px]">delete</span></button>
              </td>
            </tr>`).join('');
        }
      } catch (e) {
        tbody.innerHTML = '<tr><td colspan="7" class="py-20 text-center text-red-500">Load failed.</td></tr>';
      }
    }

    async function setupCategoryDropdowns() {
      const mainSelect = document.getElementById('mainCategorySelect');
      const subSelect = document.getElementById('subCategorySelect');
      if (!mainSelect || !subSelect) return;

      try {
        const res = await apiService.getCategories();
        if (res.success) {
          const allCategories = res.categories;
          const mainCats = allCategories.filter(c => !c.Cparent_id);
          
          mainSelect.innerHTML = '<option value="">Select Main Category</option>' + 
            mainCats.map(c => `<option value="${c.Cid}">${c.Cname}</option>`).join('');

          mainSelect.onchange = () => {
            const selectedParentId = mainSelect.value;
            if (!selectedParentId) {
              subSelect.disabled = true;
              subSelect.innerHTML = '<option value="">Select Main First</option>';
              return;
            }
            const subCats = allCategories.filter(c => c.Cparent_id == selectedParentId);
            subSelect.disabled = false;
            subSelect.innerHTML = '<option value="">Select Sub-Category</option>' + 
              subCats.map(c => `<option value="${c.Cid}">${c.Cname}</option>`).join('');
          };
        }
      } catch (err) { console.error(err); }
    }

    document.getElementById('addBookForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData.entries());
      
      data.price = parseFloat(data.price);
      data.quantity = parseInt(data.quantity);
      data.pages = 0; 
      data.publishDate = new Date().toISOString().split('T')[0];

      try {
        const res = await apiService.createBook(data);
        if (res.Bid) {
          alert("Book successfully added!");
          closeAddBookModal();
          e.target.reset();
          loadInventory(); 
        }
      } catch (err) { alert(err.message); }
    });

    function openAddBookModal() { document.getElementById('add-book-modal').classList.remove('hidden'); }
    function closeAddBookModal() { document.getElementById('add-book-modal').classList.add('hidden'); }
    
    async function handleDeleteBook(id) {
      if (confirm('Delete this book?')) {
        try {
          const res = await apiService.deleteBook(id);
          if (res.success) loadInventory();
        } catch (err) { alert(err.message); }
      }
    }
  </script>
</body>
</html>