<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <%- include('partials/head', { title: 'Purchase History' }) %>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-background-light dark:bg-[#0f172a] font-display text-slate-900 dark:text-white antialiased h-screen flex overflow-hidden">

  <%- include('partials/sidebar') %>

  <main class="flex-1 flex flex-col h-full overflow-hidden relative">
    <header class="h-16 bg-white dark:bg-[#1a2230] border-b border-slate-200 dark:border-slate-800 flex items-center px-8 flex-shrink-0 z-10">
      <h1 class="text-2xl font-bold">Purchase History</h1>
    </header>

    <div class="flex-1 overflow-y-auto p-8 scroll-smooth">
      <div class="max-w-7xl mx-auto pb-20">
        
        <div class="mb-6">
          <p class="text-slate-500 dark:text-slate-400">Review your past book orders and totals.</p>
        </div>

        <div class="bg-white dark:bg-[#1a2230] rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-500 dark:text-slate-400">
              <thead class="bg-slate-50 dark:bg-slate-900/50 text-xs uppercase font-bold border-b border-slate-200 dark:border-slate-800">
                <tr>
                  <th class="px-6 py-4 w-40">Order ID</th>
                  <th class="px-6 py-4 w-48">Date Placed</th>
                  <th class="px-6 py-4">Items</th>
                  <th class="px-6 py-4 w-32 text-right">Total</th>
                </tr>
              </thead>
              <tbody id="historyTableBody" class="divide-y divide-slate-200 dark:divide-slate-800">
                </tbody>
            </table>
          </div>
        </div>

        <div id="emptyHistory" class="hidden text-center py-24 bg-white dark:bg-[#1a2230] rounded-2xl border-2 border-dashed border-slate-200 dark:border-slate-800 mt-4">
          <span class="material-symbols-outlined text-6xl text-slate-300 mb-4">history_toggle_off</span>
          <p class="text-slate-500 font-medium">No purchase history found</p>
          <a href="/catalog" class="text-primary mt-2 inline-block hover:underline">Start Shopping</a>
        </div>
      </div>
    </div>
  </main>

  <script src="/js/api-service.js"></script>
  <script>
    async function loadPurchaseHistory() {
      const tableBody = document.getElementById('historyTableBody');
      const emptyState = document.getElementById('emptyHistory');

      try {
        const response = await apiService.getPurchaseHistory();
        if (response.success && response.purchases.length > 0) {
          emptyState.classList.add('hidden');
          tableBody.innerHTML = response.purchases.map(order => {
            const date = new Date(order.Pdate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
            return `
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                <td class="px-6 py-4 font-bold text-slate-900 dark:text-white">#${order.Pid}</td>
                <td class="px-6 py-4">${date}</td>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3 text-slate-900 dark:text-white">
                    <span class="material-symbols-outlined text-primary">menu_book</span>
                    <span class="font-medium">${order.Bname} (x${order.Pquantity})</span>
                  </div>
                </td>
                <td class="px-6 py-4 text-right font-black text-slate-900 dark:text-white">${order.Pprice} EGP</td>
              </tr>`;
          }).join('');
        } else {
          emptyState.classList.remove('hidden');
        }
      } catch (error) {
        console.error('History Error:', error);
      }
    }
    document.addEventListener('DOMContentLoaded', loadPurchaseHistory);
  </script>
</body>
</html>