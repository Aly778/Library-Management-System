<script>
// Update sidebar user info
document.addEventListener('DOMContentLoaded', () => {
  const userInfo = localStorage.getItem('user');
  if (userInfo) {
    try {
      const user = JSON.parse(userInfo);
      if (user.firstName) {
        document.getElementById('sidebarUserFirstName').textContent = user.firstName;
      }
      if (user.lastName) {
        document.getElementById('sidebarUserLastName').textContent = user.lastName;
      }
    } catch (e) {
      console.log('Could not parse user info');
    }
  }
});
</script>
